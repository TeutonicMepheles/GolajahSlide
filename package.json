{
  "name": "golajah-slide-diagrams",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pinned build-time diagram renderers for GolajahSlide",
  "scripts": {
    "test": "npm run test:python && npm run test:presenter-focus && npm run test:footer-chapter-navigation && npm run test:citations && npm run test:global-logo && npm run test:media-playback && npm run test:content-authoring && npm run test:static-export && npm run test:diagram-design && npm run test:layout-editor && npm run test:lark && npm run test:list-hierarchy",
    "test:list-hierarchy": "node tests/test_list_hierarchy.mjs",
    "test:lark": "node tests/test_lark_import.mjs",
    "test:layout-editor": "node tests/test_layout_editor.mjs",
    "test:python": "python -m unittest discover -s tests -v",
    "render:excalidraw": "node tools/render_excalidraw.mjs",
    "test:presenter-focus": "node tests/test_presenter_focus.mjs",
    "test:footer-chapter-navigation": "node tests/test_footer_chapter_navigation.mjs",
    "test:citations": "node tests/test_citations.mjs",
    "test:global-logo": "node tests/test_global_logo.mjs",
    "test:media-playback": "node tests/test_media_playback.mjs",
    "test:content-authoring": "node tests/test_content_authoring.mjs",
    "test:static-export": "node tests/test_static_export.mjs",
    "test:diagram-design": "node tests/test_diagram_design.mjs"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@mermaid-js/mermaid-cli": "11.16.0",
    "esbuild": "0.28.2",
    "puppeteer": "25.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.18"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    }
  }
}
